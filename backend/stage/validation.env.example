# Templates only. Never use these placeholders as hosted Stage credentials.
NASIM_STAGE_PROJECT=REPLACE_WITH_ISOLATED_PROJECT_NAME
NASIM_STAGE_IMAGE=REPLACE_WITH_LOCAL_IMAGE_TAG
NASIM_STAGE_BIND_ADDRESS=REPLACE_WITH_VALIDATION_BIND_ADDRESS
NASIM_STAGE_HTTP_PORT=REPLACE_WITH_VALIDATION_PORT
NASIM_STAGE_DB_NAME=REPLACE_WITH_DATABASE_NAME
NASIM_STAGE_MIGRATION_USER=REPLACE_WITH_MIGRATION_OWNER
NASIM_STAGE_MIGRATION_PASSWORD=REPLACE_WITH_EXTERNALLY_SUPPLIED_VALUE
NASIM_STAGE_DB_USER=REPLACE_WITH_RESTRICTED_RUNTIME_ROLE
NASIM_STAGE_DB_PASSWORD=REPLACE_WITH_EXTERNALLY_SUPPLIED_VALUE
NASIM_DATABASE_URL=postgresql+asyncpg://REPLACE_WITH_ROLE:REPLACE_WITH_PASSWORD@REPLACE_WITH_HOST:5432/REPLACE_WITH_DATABASE
NASIM_MIGRATION_DATABASE_URL=postgresql+asyncpg://REPLACE_WITH_OWNER:REPLACE_WITH_PASSWORD@REPLACE_WITH_HOST:5432/REPLACE_WITH_DATABASE
